{
  "datasets": {
    "cicddos2019": {
      "name": "CIC-DDoS2019",
      "source": "data/cicddos2019_mock.csv",
      "type": "csv",
      "cache": true,
      "description": "CIC-DDoS2019 dataset with labeled DDoS attack traffic"
    },
    "caida": {
      "name": "CAIDA DDoS Attack 2007",
      "source": "data/caida/",
      "type": "pcap",
      "cache": true,
      "description": "CAIDA DDoS attack dataset from 2007"
    },
    "unsw": {
      "name": "UNSW-NB15",
      "source": "data/unsw/",
      "type": "csv",
      "cache": true,
      "description": "UNSW-NB15 network intrusion dataset"
    }
  },
  "cacheDirectory": "academic/datasets/cache/",
  "features": [
    "timingCV",
    "pathDiversity",
    "requestCount",
    "headerCount",
    "hasAcceptLanguage",
    "methodVariety",
    "uaEntropy",
    "avgRequestSize",
    "hasReferer",
    "sessionDuration",
    "requestRate",
    "uniquePathRatio"
  ]
}
