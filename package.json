{
  "name": "sentinel",
  "version": "1.0.1",
  "description": "Research-grade anti-DDoS intelligence platform with adaptive threat detection, neural behavior prediction, and decentralized threat sharing",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "scripts": [
      "server.js",
      "src/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "docs/**/*",
      "data/**/*",
      ".env.example"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-win-x64",
      "node18-macos-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node server.js",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "benchmark": "node scripts/benchmark.js",
    "build:all": "npm run build:linux && npm run build:win && npm run build:macos",
    "build:linux": "npx pkg . --targets node18-linux-x64 --output dist/sentinel-linux-x64",
    "build:win": "npx pkg . --targets node18-win-x64 --output dist/sentinel-win-x64.exe",
    "build:macos": "npx pkg . --targets node18-macos-x64 --output dist/sentinel-macos-x64",
    "build:deb": "node scripts/build-deb.js",
    "build:win-setup": "node scripts/build-win-setup.js",
    "build:dmg": "node scripts/build-dmg.js",
    "build:appimage": "node scripts/build-appimage.js",
    "release": "npm test && npm run build:all && node scripts/create-release.js",
    "release:trigger": "node scripts/trigger-release.js",
    "release:local": "npm run build:all && node scripts/create-local-release.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.1",
    "prom-client": "^15.1.0",
    "winston": "^3.19.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "app-builder-lib": "^24.13.3",
    "jest": "^30.3.0",
    "pkg": "^5.8.1",
    "supertest": "^7.2.2"
  }
}
